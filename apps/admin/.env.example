# Required server-only API address; HTTPS in hosted environments.
INTERNAL_API_BASE_URL=http://127.0.0.1:8000
# Exact public origin of THIS admin deployment; used for CSRF checks.
ADMIN_APP_ORIGIN=http://127.0.0.1:3101
# Public Identity Platform web configuration; embedded at build time.
NEXT_PUBLIC_IDENTITY_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_CUSTOMER_URL=http://127.0.0.1:3100
